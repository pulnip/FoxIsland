/* Minimal flat: dark translucent panels, thin Inter type, white text, gold only on gems. */

.root {
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Inter-Regular.ttf");
    color: rgb(245, 248, 252);
}

.hidden {
    display: none;
}

.icon {
    flex-shrink: 0;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.pill {
    position: absolute;
    top: 36px;
    flex-direction: row;
    align-items: center;
    height: 72px;
    padding: 0 28px;
    background-color: rgba(14, 24, 40, 0.62);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 16px;
}

.hud__items {
    left: 36px;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud__items.hud--bump {
    scale: 1.12 1.12;
}

.hud__time {
    right: 36px;
}

.hud__center {
    position: absolute;
    top: 36px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.pill--inline {
    position: relative;
    top: 0;
    height: 56px;
    padding: 0 24px;
}

.hud__tide {
    margin-left: 16px;
    padding: 0 20px;
}

.tide__icon {
    width: 30px;
    height: 30px;
    margin-right: 14px;
    color: rgb(150, 215, 255);
}

.tide__track {
    width: 140px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.16);
    overflow: hidden;
}

.tide__fill {
    height: 100%;
    width: 0;
    border-radius: 5px;
    background-color: rgb(120, 200, 255);
}

.tide__arrow {
    width: 22px;
    height: 22px;
    margin-left: 10px;
    color: rgb(150, 215, 255);
    rotate: 90deg;
}

.tide__arrow.tide__arrow--rising {
    rotate: -90deg;
}

.pill__label--level {
    font-size: 24px;
    letter-spacing: 4px;
}

.pill__icon {
    width: 34px;
    height: 34px;
    margin-right: 16px;
}

.pill__label {
    font-size: 36px;
    letter-spacing: 1px;
    padding: 0;
}

.hints {
    position: absolute;
    left: 40px;
    bottom: 36px;
    flex-direction: row;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.hints.hints--hidden {
    opacity: 0;
}

.hint {
    flex-direction: row;
    align-items: center;
}

.hint__icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    color: rgb(245, 248, 252);
}

.hint__label {
    font-size: 22px;
    letter-spacing: 1px;
    color: rgba(245, 248, 252, 0.72);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    padding: 0;
}

.hint__label--mode {
    color: rgb(245, 248, 252);
    letter-spacing: 2px;
}

.hints__separator {
    width: 1px;
    height: 28px;
    margin: 0 28px;
    background-color: rgba(255, 255, 255, 0.25);
}

.key {
    min-width: 34px;
    height: 32px;
    margin-right: 12px;
    padding: 0 8px;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(245, 248, 252);
    background-color: rgba(14, 24, 40, 0.35);
    border-width: 1.5px;
    border-color: rgba(245, 248, 252, 0.7);
    border-radius: 6px;
}

/* ---------- Overlays and cards ---------- */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 14, 26, 0.45);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* Overlays fade instead of vanishing, so they hide by opacity rather than display. */
.overlay.hidden {
    display: flex;
    opacity: 0;
    visibility: hidden;
}

.overlay--title {
    background-color: rgba(6, 14, 26, 0.18);
}

.card {
    min-width: 440px;
    padding: 40px 48px 44px 48px;
    align-items: stretch;
    background-color: rgba(14, 24, 40, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.overlay.hidden .card {
    scale: 0.94 0.94;
}

.card__title {
    margin-bottom: 20px;
    font-size: 52px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    padding: 0;
}

.card__divider {
    height: 1px;
    margin: 0 0 24px 0;
    background-color: rgba(255, 255, 255, 0.16);
}

.card__note {
    margin-bottom: 4px;
    font-size: 22px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgba(245, 248, 252, 0.7);
    padding: 0;
}

.card__note--best {
    color: rgb(255, 209, 56);
}

.stats {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.stats__icon {
    width: 32px;
    height: 32px;
    margin-right: 14px;
}

.stats__icon--gap {
    margin-left: 44px;
}

.stats__value {
    font-size: 34px;
    letter-spacing: 1px;
    padding: 0;
}

/* ---------- Buttons ---------- */

.button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 64px;
    margin: 14px 0 0 0;
    padding: 0 32px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: rgb(245, 248, 252);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.42);
}

.button:active {
    background-color: rgba(255, 255, 255, 0.22);
    scale: 0.98 0.98;
}

.button__icon {
    width: 22px;
    height: 22px;
    margin-right: 18px;
}

.button__label {
    font-size: 26px;
    letter-spacing: 1px;
    padding: 0;
}

.button--wide {
    min-width: 320px;
    background-color: rgba(14, 24, 40, 0.62);
}

.button--quiet {
    height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.button--quiet .button__label {
    font-size: 22px;
    color: rgba(245, 248, 252, 0.7);
}

.button--quiet:hover {
    background-color: rgba(14, 24, 40, 0.35);
    border-color: rgba(0, 0, 0, 0);
}

/* ---------- Stage list ---------- */

.card--stages {
    min-width: 900px;
    padding: 32px 40px 28px 40px;
}

.stages {
    margin-bottom: 8px;
}

.stages__row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.stages__world {
    flex-direction: row;
    align-items: center;
    width: 190px;
    height: 72px;
    padding-left: 14px;
    border-left-width: 4px;
}

.stages__world-name {
    font-size: 24px;
    letter-spacing: 2px;
    padding: 0;
}

.stages__lock {
    width: 20px;
    height: 20px;
    margin-left: 10px;
    color: rgba(245, 248, 252, 0.6);
}

.stage-card {
    width: 118px;
    height: 72px;
    margin: 0 0 0 10px;
    padding: 6px 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: rgb(245, 248, 252);
}

.stage-card:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.stage-card:disabled {
    opacity: 0.35;
}

.stage-card--next {
    border-width: 2px;
    border-color: rgb(255, 209, 56);
}

.stage-card--empty {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 255, 0.08);
}

.stage-card__top {
    flex-direction: row;
    align-items: center;
}

.stage-card__label {
    font-size: 24px;
    letter-spacing: 1px;
    padding: 0;
}

.stage-card__check {
    width: 18px;
    height: 18px;
    margin-left: 6px;
    color: rgb(130, 220, 140);
}

.stage-card__time {
    font-size: 16px;
    color: rgba(245, 248, 252, 0.6);
    padding: 0;
}

/* ---------- Title ---------- */

.title {
    align-items: center;
    margin-bottom: 160px;
}

.title__mark {
    width: 96px;
    height: 96px;
    margin-bottom: 18px;
}

.title__logo {
    font-size: 120px;
    letter-spacing: 16px;
    padding: 0;
    margin-bottom: 36px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
}

.title__hint {
    margin-top: 18px;
}
